# Copie para .env (o arquivo .env não deve ir para o controle de versão) e preencha.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Recomenda-se um usuário somente leitura (veja README, "Usuário somente leitura").
SOLO_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/solo_database
NUTRICAO_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/nutricao_database
PLANTIO_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/plantio_database

# Pecuária de corte
PECUARIA_COMPRA_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/pecuaria_compra_database
PECUARIA_DESEMPENHO_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/pecuaria_desempenho_database
PECUARIA_RENTABILIDADE_DATABASE_URL=postgresql://safratech_leitura:TROQUE_A_SENHA@localhost:5432/pecuaria_rentabilidade_database

# Opcionais
# SAFRATECH_STATEMENT_TIMEOUT_MS=20000
# SAFRATECH_HISTORICO=historico/analises.jsonl

# EduAgro AI — DeepSeek (a chamada é feita só pelo backend Python; nunca coloque a chave no código)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Opcionais do EduAgro AI
# DEEPSEEK_TIMEOUT_S=90
# DEEPSEEK_MAX_REQ_MIN=20
# DEEPSEEK_MAX_TOKENS=4000
# EDUAGRO_DADOS_DIR=dados_eduagro

# EduAgro AI — busca na internet (Tavily)
TAVILY_API_KEY=
# Fonte inicial das respostas do tutor: internet (padrão: responde só com a internet) ou bancos (bancos primeiro)
# EDUAGRO_FONTE_TUTOR=internet
# Opcionais: TAVILY_MAX_RESULTADOS=5 · TAVILY_MAX_REQ_MIN=15 · EDUAGRO_BUSCA_INTERNET=0 (desliga a busca na internet)
